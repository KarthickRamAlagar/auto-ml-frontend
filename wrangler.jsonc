{
  // Auto ML frontend (App 1): the React app as Workers Static Assets.
  // /api/* is forwarded to the backend Worker (App 2) through a service binding, so the browser only ever talks to ONE
  // origin: login cookies stay first-party (HttpOnly, SameSite) and no CORS is needed.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "auto-ml-web",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // The backend must exist before this deploys: cd ../backend && npm run deploy
  "services": [{ "binding": "API", "service": "auto-ml-api" }]
}
